# Public data endpoints only. No wallet credentials are needed for scanning.
GAMMA_BASE_URL=https://gamma-api.polymarket.com
DATA_API_BASE_URL=https://data-api.polymarket.com
CLOB_BASE_URL=https://clob.polymarket.com

# Local research commands.
THEOLDTRADER_MAX_MARKETS=500
THEOLDTRADER_MAX_MULTI_OUTCOME_EVENTS=50
THEOLDTRADER_MAX_SHARES=1000
THEOLDTRADER_MIN_NET_PROFIT_USD=0.05
THEOLDTRADER_MIN_ROI_BPS=5
THEOLDTRADER_SAFETY_BUFFER_BPS=10
THEOLDTRADER_MAX_BOOK_AGE_MS=15000
THEOLDTRADER_REQUEST_TIMEOUT_MS=10000
THEOLDTRADER_PAPER_ENABLED=false
THEOLDTRADER_PAPER_STARTING_CASH=10000
THEOLDTRADER_PAPER_STATE_PATH=.theoldtrader/paper-state.json
THEOLDTRADER_PAPER_INTERVAL_MS=60000
THEOLDTRADER_PAPER_EXECUTION_DELAY_MS=2000
THEOLDTRADER_PAPER_LIQUIDITY_HAIRCUT=0.8
THEOLDTRADER_PAPER_MIN_PAIRED_FILL_RATIO=0.9
THEOLDTRADER_WHALE_MONITOR_ENABLED=false
THEOLDTRADER_WHALE_WALLETS=[]
THEOLDTRADER_WHALE_STATE_PATH=.theoldtrader/whale-state.json

# Vercel server-side connection to the deployed Worker.
# Never prefix these with NEXT_PUBLIC_.
THEOLDTRADER_WORKER_URL=
THEOLDTRADER_WORKER_API_TOKEN=
