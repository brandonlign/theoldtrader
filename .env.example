# Public data endpoints only. No wallet credentials are needed for scanning.
GAMMA_BASE_URL=https://gamma-api.polymarket.com
CLOB_BASE_URL=https://clob.polymarket.com

# Scanner limits
MONEYMOG_MAX_MARKETS=500
MONEYMOG_MAX_SHARES=1000
MONEYMOG_MIN_NET_PROFIT_USD=0.05
MONEYMOG_MIN_ROI_BPS=5
MONEYMOG_SAFETY_BUFFER_BPS=10
MONEYMOG_MAX_BOOK_AGE_MS=15000
MONEYMOG_REQUEST_TIMEOUT_MS=10000

# Intentionally disabled. Setting this to true only enables local paper accounting;
# it never submits real orders.
MONEYMOG_PAPER_ENABLED=false
MONEYMOG_PAPER_STARTING_CASH=10000
