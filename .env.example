# Public data endpoints only. No wallet credentials are needed for scanning.
GAMMA_BASE_URL=https://gamma-api.polymarket.com
DATA_API_BASE_URL=https://data-api.polymarket.com
CLOB_BASE_URL=https://clob.polymarket.com

# Local research commands.
MONEYMOG_MAX_MARKETS=500
MONEYMOG_MAX_MULTI_OUTCOME_EVENTS=50
MONEYMOG_MAX_SHARES=1000
MONEYMOG_MIN_NET_PROFIT_USD=0.05
MONEYMOG_MIN_ROI_BPS=5
MONEYMOG_SAFETY_BUFFER_BPS=10
MONEYMOG_MAX_BOOK_AGE_MS=15000
MONEYMOG_REQUEST_TIMEOUT_MS=10000
MONEYMOG_PAPER_ENABLED=false
MONEYMOG_PAPER_STARTING_CASH=10000
MONEYMOG_PAPER_STATE_PATH=.moneymog/paper-state.json
MONEYMOG_PAPER_INTERVAL_MS=60000
MONEYMOG_PAPER_EXECUTION_DELAY_MS=2000
MONEYMOG_PAPER_LIQUIDITY_HAIRCUT=0.8
MONEYMOG_PAPER_MIN_PAIRED_FILL_RATIO=0.9
MONEYMOG_WHALE_MONITOR_ENABLED=false
MONEYMOG_WHALE_WALLETS=[]
MONEYMOG_WHALE_STATE_PATH=.moneymog/whale-state.json

# Vercel server-side connection to the deployed Worker.
# Never prefix these with NEXT_PUBLIC_.
MONEYMOG_WORKER_URL=
MONEYMOG_WORKER_API_TOKEN=
