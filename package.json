{
  "name": "theoldtrader",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "description": "Paper-first Polymarket structural-arbitrage, multi-outcome, and whale-monitoring dashboard.",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm test && next build",
    "start": "next start",
    "check": "npm test",
    "scan": "node src/cli.js scan",
    "scan:multi": "node src/cli.js multi-scan",
    "scan:all": "node src/cli.js scan-all",
    "paper:once": "node src/cli.js paper-once",
    "paper:run": "node src/paper-loop.js",
    "whales:rank": "node src/cli.js whales-rank",
    "whales:observe": "node src/cli.js whales-observe",
    "research:e1:pilot": "node research/crypto/run-coinbase-maker-e1.mjs --mode=pilot",
    "research:e1:scientific": "node research/crypto/run-coinbase-maker-e1.mjs --mode=scientific",
    "research:e1:evaluate": "node research/crypto/evaluate-coinbase-maker-e1-run.mjs",
    "research:carry:flagship": "node research/crypto/carry-flagship-audit.js",
    "research:cv:connectivity": "node research/crypto/record-cross-venue-funding.mjs --connectivity-only",
    "research:cv:once": "node research/crypto/record-cross-venue-funding.mjs --once",
    "research:cv:record": "node research/crypto/record-cross-venue-funding.mjs",
    "research:cv:evaluate": "node research/crypto/cross-venue-funding-evaluate.mjs",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "next": "16.2.11",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  }
}
