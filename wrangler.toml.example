name = "theoldtrader-paper-worker"
main = "cloudflare/entry.js"
compatibility_date = "2026-08-04"
compatibility_flags = ["nodejs_compat"]

# Five-minute batches are intentionally conservative. This is not a claim that
# the free tier can scan every market every minute.
[triggers]
crons = ["*/5 * * * *"]

[[d1_databases]]
binding = "DB"
database_name = "theoldtrader"
database_id = "REPLACE_WITH_D1_DATABASE_ID"

[vars]
# Polymarket paper desk.
PAPER_SIMULATION_ENABLED = "false"
PAPER_STARTING_CASH = "10000"

# Rotating free-tier-sized Polymarket batches.
MARKET_BATCH_SIZE = "30"
EVENT_BATCH_SIZE = "5"
WHALE_BATCH_SIZE = "2"
MARKET_ROTATION_WINDOW = "600"
EVENT_ROTATION_WINDOW = "100"
BOOK_BATCH_SIZE = "80"
REQUEST_TIMEOUT_MS = "10000"
CYCLE_LOCK_TTL_MS = "240000"

# Structural strategy thresholds.
MAX_SHARES = "500"
MIN_NET_PROFIT_USD = "0.05"
MIN_ROI_BPS = "8"
SAFETY_BUFFER_BPS = "15"
MAX_BOOK_AGE_MS = "15000"
FIXED_COST_USD = "0"

# Realistic delayed Polymarket paper execution.
PAPER_EXECUTION_DELAY_MS = "2000"
PAPER_LIQUIDITY_HAIRCUT = "0.75"
PAPER_MIN_PAIRED_FILL_RATIO = "0.92"

# Risk-first Hero allocator.
HERO_MAX_RUN_ALLOCATION_PCT = "0.12"
HERO_STRUCTURAL_BUDGET_SHARE = "0.90"
HERO_WHALE_BUDGET_SHARE = "0.10"
HERO_MAX_OPPORTUNITY_PCT = "0.04"
HERO_MAX_MARKET_EXPOSURE_PCT = "0.08"
HERO_MAX_CATEGORY_EXPOSURE_PCT = "0.12"
HERO_MAX_WHALE_TRADE_PCT = "0.0075"
HERO_MAX_WHALE_TOTAL_EXPOSURE_PCT = "0.025"

# Whale research remains separately disabled until qualified wallets are added.
WHALE_MONITOR_ENABLED = "false"
WHALE_WALLETS = "[]"
WHALE_TRADE_LOOKBACK = "80"
WHALE_MAX_NEW_TRADES = "3"
WHALE_MIN_SCORE = "70"
WHALE_MIN_TRADE_USD = "100"
WHALE_MIN_RELATIVE_SIZE = "0.5"
WHALE_MAX_DELAY_SECONDS = "180"
WHALE_MAX_CHURN = "0.45"
WHALE_COPY_FRACTION = "0.01"
WHALE_MIN_COPY_USD = "10"
WHALE_MAX_COPY_USD = "75"
WHALE_MAX_PRICE_MOVE = "0.015"
WHALE_MAX_ENTRY_PRICE = "0.85"
WHALE_MAX_SLIPPAGE_BPS = "125"
WHALE_MIN_LIQUIDITY_USD = "50"
WHALE_MIN_LIQUIDITY_COVERAGE = "2"
WHALE_MIN_FORWARD_ROI = "0"
WHALE_MIN_PROFITABLE_FOLD_RATE = "0.60"
WHALE_REQUIRED_CONSENSUS = "1"

# Separate 24/7 crypto paper desk. This is paper-only and needs no exchange key.
CRYPTO_SIMULATION_ENABLED = "true"
CRYPTO_STARTING_CASH = "10000"
CRYPTO_PRODUCTS = "BTC-USD,ETH-USD,SOL-USD"
COINBASE_EXCHANGE_BASE_URL = "https://api.exchange.coinbase.com"

# The Worker cron still runs every 5 minutes for Polymarket, but crypto only polls
# once per 15-minute candle. Coinbase requests are paced and retry 429 responses.
CRYPTO_CADENCE_MINUTES = "15"
COINBASE_PUBLIC_MAX_RETRIES = "2"
COINBASE_PUBLIC_RETRY_BASE_MS = "750"
COINBASE_PUBLIC_REQUEST_INTERVAL_MS = "300"

# v2 uses namespaced variables for settings that changed from the original desk.
# This prevents a stale private wrangler.toml from silently restoring v1 behavior.
CRYPTO_V2_CANDLE_SECONDS = "900"

# Cost-aware trend + momentum + market-regime settings.
CRYPTO_FAST_EMA = "12"
CRYPTO_SLOW_EMA = "36"
CRYPTO_REGIME_EMA = "72"
CRYPTO_REGIME_LOOKBACK = "8"
CRYPTO_MOMENTUM_PERIOD = "12"
CRYPTO_RSI_PERIOD = "14"
CRYPTO_V2_MIN_TREND = "0.0018"
CRYPTO_V2_MIN_MOMENTUM = "0.004"
CRYPTO_V2_MIN_RSI = "53"
CRYPTO_V2_MAX_RSI = "68"
CRYPTO_V2_EXIT_RSI = "46"
CRYPTO_V2_MIN_REGIME_SLOPE = "0.0008"
CRYPTO_V2_MAX_ATR_PCT = "0.03"
CRYPTO_V2_MIN_VOLUME_RATIO = "0.90"
CRYPTO_V2_REQUIRED_CHECKS = "7"

# A BUY must show at least 2x the modeled round-trip friction in directional edge.
CRYPTO_V2_MIN_EDGE_TO_COST = "2.0"
CRYPTO_V2_MIN_PROJECTED_EDGE = "0.01"
CRYPTO_V2_MIN_HOLD_MINUTES = "180"
CRYPTO_V2_COOLDOWN_MINUTES = "360"

# Risk and paper-fill assumptions. Position size is stop-risk based, not a fixed 20% bet.
CRYPTO_RISK_PCT = "0.004"
CRYPTO_MAX_POSITION_PCT = "0.15"
CRYPTO_V2_MAX_EXPOSURE_PCT = "0.45"
CRYPTO_V2_CASH_RESERVE_PCT = "0.25"
CRYPTO_MIN_TRADE_USD = "25"
CRYPTO_MAX_TRADE_USD = "2000"
CRYPTO_FEE_BPS = "60"
CRYPTO_SLIPPAGE_BPS = "5"
CRYPTO_MAX_SPREAD_BPS = "35"
CRYPTO_V2_STOP_LOSS_PCT = "0.035"
CRYPTO_V2_TAKE_PROFIT_PCT = "0.075"
CRYPTO_V2_TRAILING_STOP_PCT = "0.028"
